SECRET_KEY=your-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=LocalHub <noreply@localhub.com>

# Database Configuration (if using PostgreSQL/MySQL in production)
# DB_NAME=localhub
# DB_USER=localhub_user
# DB_PASSWORD=localhub_password
# DB_HOST=localhost
# DB_PORT=5432
